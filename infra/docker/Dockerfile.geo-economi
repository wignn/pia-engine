FROM golang:1.23-alpine AS builder

WORKDIR /app
COPY services/geo-economi/go.mod ./
COPY services/geo-economi/*.go ./

ENV GOTOOLCHAIN=auto
ENV CGO_ENABLED=0
RUN go build -ldflags="-s -w" -o /geo-economi .

FROM alpine:3.20

RUN apk --no-cache add ca-certificates tzdata curl

WORKDIR /app
COPY --from=builder /geo-economi /usr/local/bin/geo-economi

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -sf http://127.0.0.1:8080/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/geo-economi"]
