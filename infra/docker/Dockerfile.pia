FROM node:22-alpine AS deps

WORKDIR /app

COPY apps/pia/package.json ./apps/pia/

WORKDIR /app/apps/pia

RUN npm install

FROM node:22-alpine AS builder

WORKDIR /app

ARG CONTROL_PLANE_INTERNAL_URL=http://control-plane:8080
ENV CONTROL_PLANE_INTERNAL_URL=${CONTROL_PLANE_INTERNAL_URL}
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/apps/pia/node_modules ./apps/pia/node_modules
COPY apps/pia/package.json ./apps/pia/package.json
COPY apps/pia/ ./apps/pia/

WORKDIR /app/apps/pia

RUN npm run build


FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs \
    /app/apps/pia/.next ./apps/pia/.next

COPY --from=builder --chown=nextjs:nodejs \
    /app/apps/pia/node_modules ./apps/pia/node_modules

COPY --from=builder --chown=nextjs:nodejs \
    /app/apps/pia/package.json ./apps/pia/package.json

COPY --from=builder --chown=nextjs:nodejs \
    /app/apps/pia/public ./apps/pia/public

USER nextjs

EXPOSE 3000

ENV PORT=3000

ENV HOSTNAME=0.0.0.0

WORKDIR /app/apps/pia
CMD ["npm", "run", "start"]