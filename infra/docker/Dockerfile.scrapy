FROM lukemathwalker/cargo-chef:latest-rust-1.95-bookworm AS chef

WORKDIR /app

FROM chef AS planner

COPY Cargo.toml Cargo.lock ./
COPY services/api-gateway/Cargo.toml services/api-gateway/Cargo.toml
COPY services/control-plane/Cargo.toml services/control-plane/Cargo.toml
COPY services/ingestion-gateway/Cargo.toml services/ingestion-gateway/Cargo.toml
COPY services/market-data/Cargo.toml services/market-data/Cargo.toml
COPY services/realtime-gateway/Cargo.toml services/realtime-gateway/Cargo.toml
COPY services/news-service/Cargo.toml services/news-service/Cargo.toml
COPY services/intelligence-service/Cargo.toml services/intelligence-service/Cargo.toml
COPY services/bot/Cargo.toml services/bot/Cargo.toml
COPY services/scrapy/Cargo.toml services/scrapy/Cargo.toml
COPY services/db-migrate/Cargo.toml services/db-migrate/Cargo.toml
COPY crates/ crates/

RUN mkdir -p services/api-gateway/src services/control-plane/src services/ingestion-gateway/src services/market-data/src services/realtime-gateway/src services/news-service/src services/intelligence-service/src services/bot/src services/scrapy/src && \
    echo "fn main(){}" > services/api-gateway/src/main.rs && \
    echo "fn main(){}" > services/control-plane/src/main.rs && \
    echo "fn main(){}" > services/ingestion-gateway/src/main.rs && \
    echo "fn main(){}" > services/market-data/src/main.rs && \
    echo "fn main(){}" > services/realtime-gateway/src/main.rs && \
    echo "fn main(){}" > services/news-service/src/main.rs && \
    echo "fn main(){}" > services/intelligence-service/src/main.rs && \
    echo "fn main(){}" > services/bot/src/main.rs && \
    echo "fn main(){}" > services/scrapy/src/main.rs

RUN mkdir -p services/scrapy/src services/db-migrate/src && \
    echo "fn main(){}" > services/scrapy/src/main.rs && \
    echo "fn main(){}" > services/db-migrate/src/main.rs

RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder

ARG DOCKER_BUILD_TYPE=release

ENV SQLX_OFFLINE=true
COPY --from=planner /app/recipe.json recipe.json

RUN if [ "$DOCKER_BUILD_TYPE" = "release" ]; then cargo chef cook --release --recipe-path recipe.json; else cargo chef cook --recipe-path recipe.json; fi

COPY Cargo.toml Cargo.lock ./
COPY services/scrapy/ services/scrapy/
COPY services/api-gateway/Cargo.toml services/api-gateway/Cargo.toml
COPY services/control-plane/Cargo.toml services/control-plane/Cargo.toml
COPY services/ingestion-gateway/Cargo.toml services/ingestion-gateway/Cargo.toml
COPY services/market-data/Cargo.toml services/market-data/Cargo.toml
COPY services/realtime-gateway/Cargo.toml services/realtime-gateway/Cargo.toml
COPY services/news-service/Cargo.toml services/news-service/Cargo.toml
COPY services/intelligence-service/Cargo.toml services/intelligence-service/Cargo.toml
COPY services/bot/Cargo.toml services/bot/Cargo.toml
COPY services/db-migrate/Cargo.toml services/db-migrate/Cargo.toml
COPY crates/ crates/

RUN mkdir -p services/api-gateway/src services/control-plane/src services/ingestion-gateway/src services/market-data/src services/realtime-gateway/src services/news-service/src services/intelligence-service/src services/bot/src && \
    echo "fn main(){}" > services/api-gateway/src/main.rs && \
    echo "fn main(){}" > services/control-plane/src/main.rs && \
    echo "fn main(){}" > services/ingestion-gateway/src/main.rs && \
    echo "fn main(){}" > services/market-data/src/main.rs && \
    echo "fn main(){}" > services/realtime-gateway/src/main.rs && \
    echo "fn main(){}" > services/news-service/src/main.rs && \
    echo "fn main(){}" > services/intelligence-service/src/main.rs && \
    echo "fn main(){}" > services/bot/src/main.rs

RUN mkdir -p services/scrapy/src services/db-migrate/src && echo "fn main(){}" > services/scrapy/src/main.rs && echo "fn main(){}" > services/db-migrate/src/main.rs

RUN if [ "$DOCKER_BUILD_TYPE" = "release" ]; then cargo build --release -p scrapy; else cargo build -p scrapy; fi
RUN if [ "$DOCKER_BUILD_TYPE" = "release" ]; then cp /app/target/release/scrapy /app/target/scrapy; else cp /app/target/debug/scrapy /app/target/scrapy; fi

FROM debian:bookworm-slim AS runtime

WORKDIR /app

# ca-certificates: scrapy makes outbound HTTPS (rustls) to target sites.
RUN apt-get update && apt-get install -y ca-certificates curl && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/scrapy /usr/local/bin/scrapy

# Stateless worker (no writable volume) — run non-root.
USER 10001:10001

ENTRYPOINT ["/usr/local/bin/scrapy"]
