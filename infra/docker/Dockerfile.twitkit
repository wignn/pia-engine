FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
COPY services/twitkit/requirements.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt \
    && python -m pip install --no-cache-dir 'nats-py>=2.9,<3' \
    && python -m pip check
COPY services/twitkit/twikit ./twikit
COPY services/twitkit/ingest.py ./
RUN mkdir -p /data && chown -R 10001:10001 /app /data
USER 10001:10001
ENV TWIKIT_COOKIES_FILE=/data/cookies.json
ENTRYPOINT ["python", "ingest.py"]
