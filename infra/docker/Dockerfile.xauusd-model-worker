FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/worker-cache/huggingface

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY services/trading-model/pyproject.toml services/trading-model/README.md ./
COPY services/trading-model/src ./src
COPY services/trading-model/requirements-worker.txt ./requirements-worker.txt
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements-worker.txt \
    && python -m pip install --no-cache-dir --no-deps .

CMD ["xauusd-model", "worker"]
