# analyzer (Python). Copy to .env.analyze (compose filename).
PORT=5000
WORKERS=2
NATS_URL=nats://nats:4222
SENTIMENT_MODEL=ProsusAI/finbert
# Gemini LLM hooks (optional):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# WHY_LLM_ENABLED=false
# ENABLE_TRANSLATION=false TRANSLATION_TARGET=en
# TRANSLATION_MAX_CHARS=2000 TRANSLATION_CHUNK_CHARS=900
# RETURN_TRANSLATED_TEXT=false RETURN_TRANSLATED_TEXT_MAX_CHARS=2000
# MAX_TOKENS=1024 NEUTRAL_THRESHOLD=0.35 MARGIN_THRESHOLD=2.0
# Options worker:
# OPTIONS_SYMBOLS=SPY,QQQ OPTIONS_EXPIRATION_DAYS=45
# OPTIONS_CONTRACT_LIMIT=200 OPTIONS_POLL_SEC=300 OPTIONS_SYMBOL_DELAY_SEC=1
# Alpaca (optional):
# ALPACA_API_KEY= ALPACA_SECRET_KEY= ALPACA_PAPER=true ALPACA_TRADE_API_URL=
