# api-gateway. Copy to .env.api-gateway.
DATABASE_URL=postgres://atlsd:replace@postgres:5432/core
# Required when internal auth is enabled on market-data/news/intelligence.
INTERNAL_API_KEY=replace-with-random-secret
# Comma-separated legacy API keys; ADMIN_API_KEY must be non-empty for admin.
ADMIN_API_KEY=replace-with-admin-secret
# API_KEYS=legacy-key-1,legacy-key-2
# API_GATEWAY_PORT=8000
# MARKET_DATA_URL=http://market-data:8010
# NEWS_SERVICE_URL=http://news-service:8030
# INTELLIGENCE_SERVICE_URL=http://intelligence-service:8040
# REDIS_URL=redis://:password@redis:6379
# REDIS_CHANNEL_PREFIX=world-info
# LOG_LEVEL=INFO
