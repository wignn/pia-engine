# control-plane. Copy to .env.control-plane.
DATABASE_URL=postgres://atlsd:replace@postgres:5432/core
REDIS_URL=redis://:password@redis:6379
JWT_SECRET=replace-with-random-secret-min-32-chars
ENCRYPTION_KEY=replace-with-32-byte-hex
ADMIN_API_KEY=replace-with-admin-secret
# OAuth (rotate these — the old ones were exposed):
GOOGLE_CLIENT_ID=replace
GOOGLE_CLIENT_SECRET=replace
GITHUB_CLIENT_ID=replace
GITHUB_CLIENT_SECRET=replace
# PORT=8080
# FRONTEND_URL=https://your-frontend.example
# ALLOWED_ORIGINS=https://your-frontend.example
# EVENTBUS_MODE=redis
# NATS_URL=nats://nats:4222
# REDIS_CHANNEL_PREFIX=world-info
