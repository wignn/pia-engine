# ingestion-gateway. Copy to .env.ingestion.
EVENTBUS_MODE=nats
NATS_URL=nats://nats:4222
PRIMARY_FX_API_KEY=replace-with-vendor-key
PRIMARY_FX_WS_URL=wss://your-primary-fx-feed
PRIMARY_FX_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD
# NOTE: variable name SECONDRY_FX_API_KEY is a code typo kept as-is;
# it is the secondary feed's API key.
SECONDRY_FX_API_KEY=
SECONDARY_FX_SYMBOLS=
CRYPTO_FEED_ENABLED=true
CRYPTO_FEED_WS_URL=wss://stream.binance.com:9443
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT
INDEX_FEED_SYMBOLS=SPX,NDX,DJI
STOCK_FEED_SYMBOLS=AAPL,MSFT
TRADINGVIEW_QUOTE_URL_TEMPLATE=https://scanner.tradingview.com/symbol?symbol={symbol}
# REDIS_URL=redis://:password@redis:6379   (required in EVENTBUS_MODE=redis/dual)
# REDIS_CHANNEL_PREFIX=ingestion
# INGESTION_HEALTH_BIND_ADDR=0.0.0.0:8091
# INGESTION_HEALTH_STALE_AFTER_SEC=180
# MARKET_CHECK_INTERVAL_SEC=30 OPTIONS_POLL_SEC=60
# RECONNECT_BASE_SEC=1 RECONNECT_MAX_SEC=60
# LOG_LEVEL=INFO
