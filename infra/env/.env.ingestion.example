# ingestion-gateway. Copy to .env.ingestion and set credentials securely.
EVENTBUS_MODE=nats
NATS_URL=nats://nats:4222

# Each Finnhub API key supports at most 50 websocket subscriptions.
PRIMARY_FX_API_KEY=replace-with-primary-finnhub-key
PRIMARY_FX_WS_URL=wss://ws.finnhub.io?token={token}
PRIMARY_FX_SYMBOLS=EURUSD|EURUSD|forex,GBPUSD|GBPUSD|forex,USDJPY|USDJPY|forex
SECONDARY_FX_API_KEY=replace-with-secondary-finnhub-key
SECONDARY_FX_SYMBOLS=NZDUSD|NZDUSD|forex,EURJPY|EURJPY|forex,GBPJPY|GBPJPY|forex

# TradingView mappings use provider|public|asset_type and share a 100-symbol non-crypto cap.
INDEX_FEED_SYMBOLS=OANDA:XAUUSD|XAUUSD|commodity,NYMEX:CL1!|WTI|commodity,SP:SPX|SPX|index,TVC:DXY|DXY|index,IDX:COMPOSITE|IHSG|index
STOCK_FEED_SYMBOLS=NASDAQ:AAPL|AAPL|stock,IDX:BBCA|BBCA|stock,IDX:GOTO|GOTO|stock
# Verify each provider ticker against the active TradingView entitlement before rollout.
TRADINGVIEW_QUOTE_URL_TEMPLATE=

# Crypto is independent from the non-crypto cap; the worker speaks OKX.
CRYPTO_FEED_ENABLED=true
CRYPTO_FEED_WS_URL=wss://ws.okx.com:8443/ws/v5/public
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT

# REDIS_URL=redis://:password@redis:6379
# REDIS_CHANNEL_PREFIX=ingestion
# INGESTION_HEALTH_BIND_ADDR=0.0.0.0:8091
# INGESTION_HEALTH_STALE_AFTER_SEC=180
# MARKET_CHECK_INTERVAL_SEC=30
# OPTIONS_POLL_SEC=60
# RECONNECT_BASE_SEC=1
# RECONNECT_MAX_SEC=60
# LOG_LEVEL=INFO
