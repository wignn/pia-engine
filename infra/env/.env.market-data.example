# market-data. Copy to .env.market-data.
DATABASE_URL=postgres://atlsd:replace@postgres:5432/core
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DATABASE=market
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace-with-datastores-secret
INTERNAL_API_KEY=replace-with-random-secret
EVENTBUS_MODE=nats
NATS_URL=nats://nats:4222
# REDIS_URL=redis://:password@redis:6379
# MARKET_DATA_PORT=8010
# MARKET_DATA_WRITE_LATEST=true
# CANDLE_GRACE_SEC=5
# FRED_API_KEY= (needed for economic/rates datasets)
# EIA_API_KEY= (needed for energy dataset)
# ALERT_NOTIFICATIONS_ENABLED=false
# COT_SYNC_SEC=86400 ECONOMIC_REFRESH_SEC=21600 RATES_REFRESH_SEC=21600
# EIA_SYNC_SEC=86400 FEAR_GREED_SYNC_SEC=3600 OPTIONS_SYNC_SEC=3600
# INSTITUTIONAL_SYNC_SEC=21600 MARKET_CALENDAR_REFRESH_SEC=3600
# ALERT_SCAN_SEC=60 ALERT_COOLDOWN_SEC=900
# LOG_LEVEL=INFO
