# news-service. Copy to .env.news-service.
DATABASE_URL=postgres://atlsd:replace@postgres:5432/core
INTERNAL_API_KEY=replace-with-random-secret
EVENTBUS_MODE=nats
NATS_URL=nats://nats:4222
# NEWS_SERVICE_PORT=8030
# NEWS_REALTIME_POLL_SEC=5  (outbox relay poll interval)
# RSS_FETCH_SEC / STOCK_FETCH_SEC / FINNHUB_NEWS_POLL_SEC / FRED_POLL_SEC
# SEC_POLL_SEC / GDELT_SYNC_SEC / CENTRAL_BANK_SYNC_SEC  (poll/sync intervals)
# LOG_LEVEL=INFO
