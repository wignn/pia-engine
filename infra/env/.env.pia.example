# Public portal runtime configuration.
# Leave empty: Next.js proxies /api/v1 through control-plane internally.
NEXT_PUBLIC_CONTROL_PLANE_URL=
# Optional override; compose supplies this for the production container.
CONTROL_PLANE_INTERNAL_URL=http://control-plane:8080
# Do not put JWT/OAuth/database secrets in this file.

# The control-plane owns FRONTEND_URL, ALLOWED_ORIGINS, JWT_SECRET,
# and the Google/GitHub OAuth credentials in .env.control-plane.
