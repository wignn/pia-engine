# public-web (SvelteKit). Copy to .env.public-web.
PUBLIC_CORE_REST_URL=https://api.your-domain.example
PUBLIC_CORE_WS_URL=wss://realtime.your-domain.example
PUBLIC_CONTROL_PLANE_URL=https://auth.your-domain.example
PUBLIC_API_KEY=replace-with-public-site-key
# CORE_API_KEY= (server-side calls to api-gateway, if used)
# FIO_API_KEY= (fetch/inline OpenData? fill if used)
# PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite
