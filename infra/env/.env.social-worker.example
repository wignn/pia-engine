# Copy to .env.social-worker on the deployment host and configure the accounts.
SOCIAL_ACCOUNTS=twitter:account_name
TWITTER_POLL_SECONDS=60
TWITTER_TWEET_LIMIT=20
TWITTER_DB=/data/accounts.db
NATS_URL=nats://nats:4222
# Core NATS subject consumed by realtime-gateway and broadcast over WebSocket.
NATS_SUBJECT=social.posts
# NATS_CREDS=/run/secrets/nats.creds
# X_AUTH_TOKEN=
# X_CT0=
X_ACCOUNT_NAME=worker
LOG_LEVEL=INFO
