# --- ATLSD Terminal App environment (example) ---
NODE_ENV=production

# Server-side: reach core API via internal traffic-router (container network).
CORE_REST_URL=http://traffic-router
CORE_API_KEY=changeme

# Client-side public endpoints (used by browser for realtime later).
NEXT_PUBLIC_CORE_REST_URL=https://api-engine.example.com
NEXT_PUBLIC_CORE_WS_URL=wss://realtime-engine.example.com
NEXT_PUBLIC_API_KEY=changeme
