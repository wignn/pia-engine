# Copy to .env.trading-model on the host and use a dedicated least-privilege
# PostgreSQL login for model_worker_user. Never commit the populated file.
TRADING_MODEL_POSTGRES_URL=
TRADING_MODEL_CLICKHOUSE_URL=
TRADING_MODEL_RUN_DIR=/models/active
TRADING_MODEL_CACHE_DIR=/worker-cache
TRADING_MODEL_POLL_SECONDS=30
